        "text": "=A new project request was submitted.\n\nName: {{ $json.full_name }}\nCompany: {{ $json.company }}\nEmail: {{ $json.email }}\nProject Title: {{ $json.project_title }}\nDescription: {{ $json.project_description }}\n\nAnalyze the request and return the structured fields.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are the Reception Agent of an AI-run software company. Your job is to receive incoming project requests, detect the language, write a concise professional summary, classify the request into a category, and estimate its priority. Always respond using the required structured output schema."
        }
