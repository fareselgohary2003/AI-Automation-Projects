    {
      "parameters": {
        "jsCode": "\nconst pm = $('Project Manager Agent').item.json.output || {};\nconst prep = $('Prepare Records').item.json;\nconst tasks = Array.isArray(pm.tasks) ? pm.tasks : [];\n\nconst now = new Date();\nconst out = [];\nfor (let i = 0; i < tasks.length; i++) {\n  const t = tasks[i] || {};\n  out.push({\n    json: {\n      task_id: prep.project_id + '-T' + (i + 1),\n      project_id: prep.project_id,\n      title: t.title || ('Task ' + (i + 1)),\n      description: t.description || '',\n      department: t.department || 'business_analysis',\n      status: 'todo',\n      priority: t.priority || prep.priority || 'medium',\n      estimated_days: typeof t.estimated_days === 'number' ? t.estimated_days : 1,\n      created_date: now.toISOString(),\n    },\n  });\n}\nreturn out.length ? out : [{ json: {\n  task_id: prep.project_id + '-T1',\n  project_id: prep.project_id,\n  title: 'Review project request',\n  description: prep.summary,\n  department: 'business_analysis',\n  status: 'todo',\n  priority: prep.priority || 'medium',\n  estimated_days: 1,\n  created_date: now.toISOString(),\n} }];\n"
      },
