    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"language\":{\"type\":\"string\",\"description\":\"ISO language of the request, e.g. en, ar, fr\"},\"summary\":{\"type\":\"string\",\"description\":\"One-paragraph summary of the request\"},\"category\":{\"type\":\"string\",\"description\":\"One of: web, mobile, ai, automation, data, design, consulting, other\"},\"priority\":{\"type\":\"string\",\"description\":\"One of: low, medium, high, urgent\"}},\"required\":[\"language\",\"summary\",\"category\",\"priority\"]}"
      },
      "id": "af6348bc-11d8-4684-9234-9ed12aee413a",
      "name": "Reception Output Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        368,
        336
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst form = $('Project Intake Form').item.json;\nconst rec = $('Reception Agent').item.json.output || {};\n\nconst now = new Date();\nconst stamp = now.getTime().toString(36).toUpperCase();\nconst rand = Math.floor(Math.random() * 9000 + 1000);\n\nconst projectId = 'PRJ-' + stamp + '-' + rand;\nconst clientId = 'CLI-' + (form.email || 'unknown').split('@')[0].replace(/[^a-zA-Z0-9]/g, '').toUpperCase().slice(0, 8) + '-' + rand;\n\nreturn [{\n  json: {\n    project_id: projectId,\n    client_id: clientId,\n    full_name: form.full_name || '',\n    email: form.email || '',\n    company: form.company || '',\n    project_title: form.project_title || '',\n    project_description: form.project_description || '',\n    language: rec.language || 'en',\n    summary: rec.summary || form.project_description || '',\n    category: rec.category || 'other',\n    priority: rec.priority || 'medium',\n    created_at: now.toISOString(),\n  },\n}];\n"
      },
