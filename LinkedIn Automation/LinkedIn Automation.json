      "id": "6414136c-1dcd-4cea-a3ad-032c9075acd2",
      "name": "Parse RSS",
      "type": "n8n-nodes-base.xml",
      "typeVersion": 1,
      "position": [
        -2016,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json || {};\nconst channel = j.rss && j.rss.channel ? j.rss.channel : (j.channel || {});\nlet items = channel.item || [];\nif (!Array.isArray(items)) items = [items];\nconst parsed = items.filter(a => a && a.title && a.link).map(a => {\n  const title = typeof a.title === 'string' ? a.title : (a.title && a.title._ ? a.title._ : '');\n  const link = typeof a.link === 'string' ? a.link : (a.link && a.link._ ? a.link._ : '');\n  const pub = a.pubDate || '';\n  let source = '';\n  if (a.source) source = typeof a.source === 'string' ? a.source : (a.source._ || a.source.url || '');\n  return { title: title.trim(), url: link.trim(), source: source, published_at: pub, ts: pub ? Date.parse(pub) : 0 };\n});\nif (!parsed.length) { throw new Error('No AI news found today'); }\nparsed.sort((x, y) => (y.ts || 0) - (x.ts || 0));\nconst best = parsed[0];\nreturn [{ json: { title: best.title, url: best.url, source: best.source, published_at: best.published_at } }];"
      },
      "id": "894dbda2-19d8-4d62-8d41-0adb49258705",
      "name": "Pick Latest Story",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1648,
        224
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini",
          "cachedResultName": "gpt-5-mini"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are an AI/ML technical content writer. Write ONE professional LinkedIn post about the AI news item provided.\nBase the post ONLY on the given information — never invent facts, statistics, quotes, or capabilities.\nStyle: natural, professional, concise, human-sounding (not marketing fluff). Start with a strong hook, explain what happened and why it matters, include the source link, and add 3-5 relevant hashtags.\nReturn ONLY JSON: { \"post\": \"...\", \"title\": \"...\", \"source_url\": \"...\" }"
            },
            {
              "content": "=AI news item:\nTitle: {{ $json.title }}\nSource: {{ $json.source }}\nPublished: {{ $json.published_at }}\nSource URL: {{ $json.url }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "maxTokens": 4000,
          "textFormat": {
            "textOptions": {
              "type": "json_object"
            }
          }
        }
      },
      "id": "c7dd00bb-f149-4e80-ab88-3bb7a94e04cc",
      "name": "Generate LinkedIn Post",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        -1408,
        208
      ],
      "credentials": {
        "openAiApi": {
          "id": "uvd6VoqxcRng7NaN",
          "name": "n8n free OpenAI API credits"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "function extractText(j){\n  if(!j) return '';\n  if(typeof j==='string') return j;\n  if(Array.isArray(j.output)){ const p=[]; for(const o of j.output){ if(Array.isArray(o.content)){ for(const c of o.content){ if(c && c.text!=null) p.push(typeof c.text==='string'?c.text:JSON.stringify(c.text)); } } } if(p.length) return p.join(''); }\n  if(typeof j.text==='string') return j.text;\n  if(j.message && typeof j.message.content==='string') return j.message.content;\n  return JSON.stringify(j);\n}\nconst text = extractText($('Generate LinkedIn Post').item.json).replace(/```json/gi,'').replace(/```/g,'').trim();\nlet obj; try { obj = JSON.parse(text); } catch(e){ throw new Error('Malformed LLM JSON: ' + e.message); }\nconst src = $('Pick Latest Story').item.json;\nreturn [{ json: {\n  post: (obj.post || '').toString(),\n  title: (obj.title || src.title || '').toString(),\n  source_url: (obj.source_url || src.url || '').toString()\n} }];"
      },
