    {
      "parameters": {
        "jsCode": "const booking = $json;\n\nconst subject = `🏥 Appointment Confirmation | ${booking[\"Department\"]}`;\n\nconst body = `\nHello ${booking[\"Full Name\"]},\n\nYour appointment has been successfully confirmed.\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n📋 APPOINTMENT DETAILS\n\n🎟 Queue Number:\n${booking[\"Queue Number\"]}\n\n🆔 Booking ID:\n${booking[\"Booking ID\"]}\n\n👨‍⚕️ Doctor:\n${booking[\"Doctor\"]}\n\n🏥 Department:\n${booking[\"Department\"]}\n\n📅 Date:\n${booking[\"Appointment Date\"]}\n\n🕒 Time:\n${booking[\"Appointment Time\"]}\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n👤 PATIENT INFORMATION\n\nName:\n${booking[\"Full Name\"]}\n\nPhone:\n${booking[\"Phone\"]}\n\nEmail:\n${booking[\"Email\"]}\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n📌 Please arrive at least 15 minutes before your appointment.\n\nIf you need to cancel or reschedule, please contact the hospital.\n\nBooking Status:\n✅ ${booking[\"Status\"]}\n\nThank you for choosing our hospital.\n\nWe wish you a speedy recovery.\n\nBest Regards,\nHospital Management\n`;\n\nreturn [{\n  json: {\n    ...booking,\n    subject,\n    emailBody: body\n  }\n}];"
      },
      "id": "4c21b079-9c45-42e9-a222-1a21d9210426",
