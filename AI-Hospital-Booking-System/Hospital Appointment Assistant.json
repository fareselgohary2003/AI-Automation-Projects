    {
      "parameters": {
        "jsCode": "// Pull each value from the node that actually holds it\nconst patient = $('Patient Details').first().json;\nconst department = $('Choose Department').first().json.department || \"\";\nconst doctor = $('Choose Doctor').first().json.doctor_name || \"\";\n\n// The slot looks like \"Saturday - 10:00 AM\" -> split into day and time\nconst slot = $('Choose Slot').first().json.appointment_slot || \"\";\nconst slotParts = slot.split(\" - \");\nconst appointmentDate = slotParts[0] || \"\";\nconst appointmentTime = slotParts.slice(1).join(\" - \") || \"\";\n\nconst queueNumber = $input.all().length + 1;\nconst bookingId = `BK-${Date.now()}`;\nconst bookingDate = new Date().toLocaleString(\"en-GB\", {\n  day: \"2-digit\",\n  month: \"2-digit\",\n  year: \"numeric\",\n  hour: \"2-digit\",\n  minute: \"2-digit\"\n});\n\nreturn [{\n  json: {\n    \"Queue Number\": queueNumber,\n    \"Booking ID\": bookingId,\n    \"Booking Date\": bookingDate,\n\n    \"Full Name\": patient.patient_name || \"\",\n    \"Email\": patient.email || \"\",\n    \"Phone\": patient.phone || \"\",\n    \"Age\": patient.age || \"\",\n    \"Gender\": patient.gender || \"\",\n\n    \"Department\": department,\n    \"Doctor\": doctor,\n\n    \"Appointment Date\": appointmentDate,\n    \"Appointment Time\": appointmentTime,\n\n    \"Notes\": patient.notes || \"-\",\n\n    \"Status\": \"Confirmed\"\n  }\n}];"
      },
