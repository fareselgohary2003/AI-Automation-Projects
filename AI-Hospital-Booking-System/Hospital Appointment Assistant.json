    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nlet html = '<div style=\"text-align:left\"><h3>Available Doctors</h3>';\nfor (const r of rows) {\n  html += '<p><b>' + r.doctor_name + '</b><br/>' + r.specialty + '<br/>\\u2B50 ' + r.rating + '/5 (' + r.review_count + ' reviews)</p>';\n}\nhtml += '</div>';\nconst values = rows.map(r => ({ option: r.doctor_name }));\nconst fields = [\n  { fieldType: 'html', html: html },\n  { fieldLabel: 'Choose your doctor', fieldName: 'doctor_name', fieldType: 'dropdown', fieldOptions: { values: values }, requiredField: true },\n];\nreturn [{ json: { formFieldsJson: JSON.stringify(fields) } }];"
      },
