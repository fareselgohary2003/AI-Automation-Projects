    {
      "parameters": {
        "sendTo": "={{ $json[\"Email\"] }}",
        "subject": "=Appointment Confirmation - {{ $json[\"Booking ID\"] }}",
        "message": "=<h2 style=\"color:#2E86C1;\">🏥 Hospital Appointment Confirmation</h2>\n\n<p>Dear <strong>{{ $json[\"Full Name\"] }}</strong>,</p>\n\n<p>Your appointment has been successfully confirmed.</p>\n\n<hr>\n\n<h3>📋 Appointment Details</h3>\n\n<table border=\"1\" cellpadding=\"8\" cellspacing=\"0\" style=\"border-collapse:collapse;\">\n<tr>\n<td><strong>🎟 Queue Number</strong></td>\n<td>{{ $json[\"Queue Number\"] }}</td>\n</tr>\n\n<tr>\n<td><strong>🆔 Booking ID</strong></td>\n<td>{{ $json[\"Booking ID\"] }}</td>\n</tr>\n\n<tr>\n<td><strong>🏥 Department</strong></td>\n<td>{{ $json[\"Department\"] }}</td>\n</tr>\n\n<tr>\n<td><strong>👨‍⚕️ Doctor</strong></td>\n<td>{{ $json[\"Doctor\"] }}</td>\n</tr>\n\n<tr>\n<td><strong>📅 Appointment Date</strong></td>\n<td>{{ $json[\"Appointment Date\"] }}</td>\n</tr>\n\n<tr>\n<td><strong>🕒 Appointment Time</strong></td>\n<td>{{ $json[\"Appointment Time\"] }}</td>\n</tr>\n\n<tr>\n<td><strong>📌 Status</strong></td>\n<td><strong style=\"color:green;\">{{ $json[\"Status\"] }}</strong></td>\n</tr>\n</table>\n\n<br>\n\n<h3>👤 Patient Information</h3>\n\n<table border=\"1\" cellpadding=\"8\" cellspacing=\"0\" style=\"border-collapse:collapse;\">\n<tr>\n<td><strong>Full Name</strong></td>\n<td>{{ $json[\"Full Name\"] }}</td>\n</tr>\n\n<tr>\n<td><strong>Phone</strong></td>\n<td>{{ $json[\"Phone\"] }}</td>\n</tr>\n\n<tr>\n<td><strong>Email</strong></td>\n<td>{{ $json[\"Email\"] }}</td>\n</tr>\n\n<tr>\n<td><strong>Age</strong></td>\n<td>{{ $json[\"Age\"] }}</td>\n</tr>\n\n<tr>\n<td><strong>Gender</strong></td>\n<td>{{ $json[\"Gender\"] }}</td>\n</tr>\n\n<tr>\n<td><strong>Notes</strong></td>\n<td>{{ $json[\"Notes\"] }}</td>\n</tr>\n</table>\n\n<br>\n\n<p><strong>📍 Please arrive at least 15 minutes before your appointment.</strong></p>\n\n<p>If you need to cancel or reschedule your appointment, please contact the hospital in advance.</p>\n\n<hr>\n\n<p>Thank you for choosing our hospital.</p>\n\n<p>We wish you a speedy recovery. ❤️</p>\n\n<p><strong>Hospital Management Team</strong></p>",
