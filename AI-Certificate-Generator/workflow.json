    {
      "parameters": {
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Certificate of Completion</title>\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600&family=Poppins:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap');\n\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n\n  body {\n    background: #f0ede6;\n    font-family: 'Poppins', sans-serif;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    min-height: 100vh;\n    padding: 20px;\n  }\n\n  .certificate {\n    position: relative;\n    width: 900px;\n    height: 640px;\n    background: #fffdfb;\n    padding: 60px 70px;\n    overflow: hidden;\n  }\n\n  /* Corner border lines */\n  .top-line, .bottom-line {\n    position: absolute;\n    left: 40px;\n    right: 40px;\n    height: 2px;\n    background: #b89c7d;\n  }\n  .top-line { top: 34px; }\n  .bottom-line { bottom: 34px; }\n\n  .side-line {\n    position: absolute;\n    top: 30px;\n    bottom: 30px;\n    width: 2px;\n    background: #b89c7d;\n  }\n  .side-line.left { left: 40px; }\n  .side-line.right { right: 40px; }\n\n  /* Stars */\n  .star {\n    position: absolute;\n    font-size: 20px;\n    color: #b89c7d;\n  }\n  .star.tl { top: 14px; left: 14px; }\n  .star.tr { top: 14px; right: 14px; }\n  .star.bl { bottom: 14px; left: 14px; }\n  .star.br { bottom: 14px; right: 14px; }\n\n  .content {\n    position: relative;\n    z-index: 2;\n    text-align: center;\n  }\n\n  .logo-icon {\n    width: 40px;\n    height: 40px;\n    margin: 0 auto 4px;\n    color: #8a7259;\n  }\n\n  .brand-name {\n    font-size: 11px;\n    letter-spacing: 2px;\n    color: #8a7259;\n    font-weight: 600;\n    line-height: 1.5;\n    margin-bottom: 18px;\n  }\n\n  h1.title {\n    font-family: 'Playfair Display', serif;\n    font-size: 72px;\n    font-weight: 500;\n    letter-spacing: 8px;\n    color: #1a1a1a;\n    margin-bottom: 4px;\n  }\n\n  .subtitle {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 16px;\n    color: #b89c7d;\n    font-size: 15px;\n    letter-spacing: 4px;\n    font-weight: 500;\n    margin-bottom: 48px;\n  }\n  .subtitle .line { width: 90px; height: 1px; background: #d8c6ae; }\n\n  .presented-to {\n    font-size: 11px;\n    letter-spacing: 3px;\n    color: #333;\n    font-weight: 500;\n    border-bottom: 2px solid #b89c7d;\n    display: inline-block;\n    padding-bottom: 5px;\n    margin-bottom: 16px;\n  }\n\n  .student-name {\n    font-family: 'Playfair Display', serif;\n    font-size: 42px;\n    letter-spacing: 6px;\n    color: #111;\n    padding-bottom: 12px;\n    border-bottom: 1px solid #ccc;\n    margin: 0 auto 28px;\n    display: inline-block;\n    min-width: 420px;\n  }\n\n  .description {\n    font-size: 13px;\n    color: #17335c;\n    line-height: 1.9;\n    max-width: 520px;\n    margin: 0 auto 55px;\n  }\n\n  .footer {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-end;\n    padding: 0 10px;\n  }\n\n  .signature-block, .date-block {\n    text-align: left;\n  }\n  .date-block { text-align: right; }\n\n  .signature-name {\n    font-family: 'Brush Script MT', cursive;\n    font-size: 34px;\n    color: #222;\n    margin-bottom: 2px;\n  }\n\n  .date-value {\n    font-family: 'Playfair Display', serif;\n    font-size: 15px;\n    letter-spacing: 3px;\n    color: #1a1a1a;\n    margin-bottom: 6px;\n  }\n\n  .line-under {\n    width: 210px;\n    border-bottom: 1px solid #999;\n    margin-bottom: 6px;\n  }\n\n  .director-name {\n    font-size: 11px;\n    font-weight: 600;\n    letter-spacing: 1px;\n    color: #17335c;\n  }\n\n  .director-role {\n    font-size: 10px;\n    letter-spacing: 2px;\n    color: #b89c7d;\n    margin-top: 2px;\n  }\n\n  .date-label {\n    font-size: 10px;\n    letter-spacing: 2px;\n    color: #b89c7d;\n    margin-top: 2px;\n  }\n</style>\n</head>\n<body>\n\n  <div class=\"certificate\">\n    <div class=\"top-line\"></div>\n    <div class=\"bottom-line\"></div>\n    <div class=\"side-line left\"></div>\n    <div class=\"side-line right\"></div>\n\n    <div class=\"star tl\">✦</div>\n    <div class=\"star tr\">✦</div>\n    <div class=\"star bl\">✦</div>\n    <div class=\"star br\">✦</div>\n\n    <div class=\"content\">\n      <svg class=\"logo-icon\" viewBox=\"0 0 100 100\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <polygon points=\"50,5 90,27.5 90,72.5 50,95 10,72.5 10,27.5\" stroke=\"currentColor\" stroke-width=\"4\" fill=\"none\"/>\n        <circle cx=\"50\" cy=\"45\" r=\"12\" stroke=\"currentColor\" stroke-width=\"4\" fill=\"none\"/>\n        <line x1=\"50\" y1=\"57\" x2=\"50\" y2=\"72\" stroke=\"currentColor\" stroke-width=\"4\"/>\n      </svg>\n      <div class=\"brand-name\">BROOKSTONE<br>UNIVERSITY</div>\n\n      <h1 class=\"title\">CERTIFICATE</h1>\n      <div class=\"subtitle\"><span class=\"line\"></span> OF COMPLETION <span class=\"line\"></span></div>\n\n      <div class=\"presented-to\">PRESENTED TO</div>\n      <div class=\"student-name\"><b>{{ $json['Enter your name'] }}</b></div>\n\n      <div class=\"description\">\n        For successfully completing the <b>{{ $json['Course '] }}</b>  course<br>\n        conducted by Brookstone University on<b> {{ $json.Date }}</b>.<br>\n        Your dedication and commitment are highly appreciated\n      </div>\n\n      <div class=\"footer\">\n        <div class=\"signature-block\">\n          <div class=\"signature-name\">{{ $json['Director Name'] }}</div>\n          <div class=\"line-under\"></div>\n          <div class=\"director-name\"><b>{{ $json['Director Name'] }}</b></div>\n          <div class=\"director-role\">DIRECTOR</div>\n        </div>\n\n        <div class=\"date-block\">\n          <div class=\"date-value\"><b>{{ $json.Date }}</b></div>\n          <div class=\"line-under\"></div>\n          <div class=\"date-label\">DATE</div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n</body>\n</html>"
      },
