    {
      "parameters": {
        "jsCode": "\nconst d = $('Decide Action').item.json;\nconst item = $input.first();\nconst binMeta = (item.binary && item.binary.data) || {};\nconst mime = binMeta.mimeType || 'image/jpeg';\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst b64 = buffer.toString('base64');\nconst dataUri = 'data:' + mime + ';base64,' + b64;\nconst FIXED_PROMPT = [\n\"Create a realistic 10-second cinematic video using the 5-6 uploaded reference photos of the two people. Preserve their exact facial features, hairstyle, skin tone, body proportions, and clothing style consistently throughout the video.\",\n\"\",\n\"Scene:\",\n\"The two friends are walking together on a quiet street at sunset, laughing naturally. One friend playfully bumps the other's shoulder, and the other laughs, points at him jokingly, then they both continue walking side by side. At the end of the clip, they look at the camera, smile, and do a casual fist bump.\",\n\"\",\n\"Style:\",\n\"Ultra-realistic, cinematic, natural body movement, authentic facial expressions, smooth camera motion, warm golden-hour lighting, shallow depth of field, high-quality skin details, realistic shadows, 4K, 24 fps.\",\n\"\",\n\"Camera:\",\n\"Start with a medium tracking shot from the front, slowly move closer, then finish with a close-up during the fist bump.\",\n\"\",\n\"Requirements:\",\n\"- Keep both identities identical to the reference photos.\",\n\"- No face distortion or identity changes.\",\n\"- Natural lip movement and eye contact.\",\n\"- Realistic walking animation.\",\n\"- Stable camera with no flickering.\",\n\"- Duration: exactly 10 seconds.\",\n\"- No subtitles, no text, no watermark.\"\n].join('\\n');\nconst falBody = {\n  prompt: FIXED_PROMPT,\n  image_url: dataUri,\n  duration: '10',\n  aspect_ratio: '16:9',\n};\nreturn [{ json: { falBody, chatId: d.chatId, telegramId: d.telegramId } }];\n"
      },
