      "typeVersion": 1.1,
      "position": [
        448,
        384
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "\nconst p = $('Parse Update').item.json;\nconst s = $input.first().json || {};\nconst state = s.state || 'idle';\nlet images = [];\ntry { images = JSON.parse(s.images_json || '[]'); } catch (e) { images = []; }\nif (!Array.isArray(images)) images = [];\n\nconst cmd = p.command;\nlet action = 'fallback';\nlet newImages = images;\nlet newState = state;\n\nif (cmd === '/start' || cmd === '/help') {\n  action = 'help';\n} else if (cmd === '/newvideo') {\n  action = 'start_new'; newState = 'awaiting_images'; newImages = [];\n} else if (state === 'awaiting_images' && p.hasPhoto) {\n  if (images.length < 20) newImages = images.concat([p.photoFileId]);\n  action = 'collect_image'; newState = 'awaiting_images';\n} else if (state === 'awaiting_images' && p.text && !p.hasPhoto && !cmd) {\n  if (images.length >= 1) { action = 'generate'; newState = 'generating'; }\n  else { action = 'fallback'; }\n}\n\nlet replyText = '';\nif (action === 'fallback') {\n  if (state === 'awaiting_images') replyText = \"You have sent \" + images.length + \" image(s). Send at least 1 photo, then send any text (e.g. done) to start generating.\";\n  else if (state === 'generating') replyText = 'A video is already being generated. Please wait for it to finish.';\n  else replyText = 'Welcome! Send /newvideo to start, then just send your images.';\n}\n\nreturn [{ json: {\n  action,\n  chatId: p.chatId,\n  telegramId: p.telegramId,\n  prompt: '',\n  imagesJson: JSON.stringify(newImages),\n  imageCount: newImages.length,\n  firstImageId: newImages[0] || '',\n  replyText,\n} }];\n"
      },
