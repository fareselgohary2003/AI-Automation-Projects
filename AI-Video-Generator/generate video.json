    {
      "parameters": {
        "jsCode": "\nconst item = $input.first().json;\nconst msg = item.message || item.edited_message || {};\nlet chatId = msg.chat ? msg.chat.id : undefined;\nlet userId = msg.from ? msg.from.id : undefined;\nlet text = (msg.text || '').trim();\nlet command = '';\nlet photoFileId = '';\nlet hasPhoto = false;\nif (Array.isArray(msg.photo) && msg.photo.length) {\n  hasPhoto = true;\n  photoFileId = msg.photo[msg.photo.length - 1].file_id;\n}\nif (!hasPhoto && msg.document && (msg.document.mime_type || '').startsWith('image/')) {\n  hasPhoto = true;\n  photoFileId = msg.document.file_id;\n}\nif (text.startsWith('/')) {\n  command = text.split(/\\s+/)[0].toLowerCase().replace(/@.*$/, '');\n}\nreturn [{ json: {\n  chatId: chatId !== undefined ? String(chatId) : '',\n  telegramId: userId !== undefined ? String(userId) : '',\n  text, command, photoFileId, hasPhoto,\n} }];\n"
      },
      "id": "b6bb4ced-0b59-4a30-ade2-d702bf64baf3",
      "name": "Parse Update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
